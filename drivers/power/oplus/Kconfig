config OPLUS_CHARGER
	bool "OPLUS Charger Driver (SM7150R)"
	depends on MACH_OPLUS && I2C
	select REGMAP_I2C
	help
	  Say Y here to enable OPLUS charging system support

if OPLUS_CHARGER

config OPLUS_SM7150R_CHARGER
	bool "OPLUS SM7150R charger driver"
	default y
	help
	  Compatibility symbol used by the original SM7150R charging sources.

